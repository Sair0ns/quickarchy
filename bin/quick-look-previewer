#!/usr/bin/env python3
"""Expose Omarchy QuickArchy as the GNOME file previewer.

Nautilus does not let extensions bind keys. What it does instead is D-Bus
activate the well-known name `org.gnome.NautilusPreviewer` when the user
presses Space on a selection, and call ShowFile on it. Owning that name is
therefore the supported way to make Space open our own previewer instead of
the stock one (sushi).

Both the current `org.gnome.NautilusPreviewer2` interface and the older
`org.gnome.NautilusPreviewer` interface are exported, because Nautilus falls
back to v1 when the v2 proxy cannot be created.

The `Visible` property is not decoration: Nautilus caches it and gates its
"follow the selection" path on it (`nautilus_previewer_is_visible()` in
nautilus-previewer.c reads the cached property, and
`nautilus_files_view_preview_update()` returns early while it is false). A
bridge that never updates it leaves Nautilus believing the preview is open
forever, so a plain selection change re-opens the preview. This bridge
therefore emits `PropertiesChanged` for `Visible`: once after claiming the
name, whenever it shows or closes a file, and from a short poll that notices
the user closing the card from inside the shell.

Removing ~/.local/share/dbus-1/services/org.gnome.NautilusPreviewer.service
hands the Space key straight back to sushi.
"""

import json
import subprocess
import sys
import urllib.parse

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

BUS_NAME = "org.gnome.NautilusPreviewer"
OBJECT_PATH = "/org/gnome/NautilusPreviewer"
IPC_TARGET = "sairons.quickarchy"

IFACES = ("org.gnome.NautilusPreviewer2", "org.gnome.NautilusPreviewer")
PROPERTIES_IFACE = "org.freedesktop.DBus.Properties"

# Nothing has asked us to preview anything for this long, so the service exits
# and lets D-Bus activate it again on the next Space press.
IDLE_TIMEOUT_SECONDS = 900

# How often to check whether the card is still on screen, so that closing it
# from inside the shell (Space or Escape in the card) reaches Nautilus.
VISIBLE_POLL_MS = 400

NODE_XML = """
<node>
  <interface name="org.gnome.NautilusPreviewer2">
    <method name="ShowFile">
      <arg type="s" name="uri" direction="in"/>
      <arg type="s" name="windowHandle" direction="in"/>
      <arg type="b" name="closeIfAlreadyShown" direction="in"/>
      <arg type="s" name="activationToken" direction="in"/>
    </method>
    <method name="Close"/>
    <signal name="SelectionEvent">
      <arg type="q" name="direction"/>
    </signal>
    <property type="s" name="ParentHandle" access="read"/>
    <property type="b" name="Visible" access="read"/>
  </interface>
  <interface name="org.gnome.NautilusPreviewer">
    <method name="ShowFile">
      <arg type="s" name="uri" direction="in"/>
      <arg type="i" name="xid" direction="in"/>
      <arg type="b" name="closeIfAlreadyShown" direction="in"/>
    </method>
    <method name="Close"/>
    <property type="b" name="Visible" access="read"/>
  </interface>
</node>
"""


def uri_to_path(uri):
    """Return a local filesystem path, or None for anything not on disk."""
    text = str(uri or "")
    if text.startswith("/"):
        return text
    parsed = urllib.parse.urlparse(text)
    if parsed.scheme != "file":
        return None
    return urllib.parse.unquote(parsed.path) or None


def omarchy_shell(*args):
    """Call the shell's IPC and return stdout, or None when it fails."""
    try:
        proc = subprocess.run(
            ["omarchy-shell", *args],
            capture_output=True, timeout=15, check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if proc.returncode != 0:
        return None
    return proc.stdout.decode("utf-8", "replace").strip()


class Previewer:
    def __init__(self, loop):
        self.loop = loop
        self.connection = None
        self.parent_handle = ""
        self.current_path = None
        self.visible_cached = None
        self._idle_source = None
        self._poll_source = None
        self._reset_idle()

    # -- lifetime ---------------------------------------------------------

    def _reset_idle(self):
        if self._idle_source is not None:
            GLib.source_remove(self._idle_source)
        self._idle_source = GLib.timeout_add_seconds(
            IDLE_TIMEOUT_SECONDS, self._on_idle,
        )

    def _on_idle(self):
        self._idle_source = None
        if not self.visible():
            self.loop.quit()
            return False
        self._reset_idle()
        return False

    # -- the Visible property ---------------------------------------------

    def _emit_visible(self, value):
        if self.connection is None:
            return
        for iface in IFACES:
            try:
                self.connection.emit_signal(
                    None, OBJECT_PATH, PROPERTIES_IFACE, "PropertiesChanged",
                    GLib.Variant("(sa{sv}as)",
                                 (iface, {"Visible": GLib.Variant("b", value)}, [])),
                )
            except Exception as exc:  # bus gone: nothing left to keep in sync
                sys.stderr.write("quick-look-previewer: %s\n" % exc)

    def set_visible(self, value):
        """Update the cached state Nautilus reads, telling it when it changes."""
        value = bool(value)
        if value == self.visible_cached:
            return
        self.visible_cached = value
        self._emit_visible(value)
        if value:
            self._start_poll()
        else:
            self._stop_poll()

    def _start_poll(self):
        if self._poll_source is None:
            self._poll_source = GLib.timeout_add(VISIBLE_POLL_MS, self._poll_visible)

    def _stop_poll(self):
        if self._poll_source is not None:
            GLib.source_remove(self._poll_source)
            self._poll_source = None

    def _poll_visible(self):
        if not self.visible():
            self._poll_source = None
            self.current_path = None
            self._reset_idle()
            self.set_visible(False)
            return False
        return True

    # -- state ------------------------------------------------------------

    def visible(self):
        return omarchy_shell(IPC_TARGET, "isOpen") == "true"

    # -- actions ----------------------------------------------------------

    def show_file(self, uri, close_if_already_shown, parent_handle=""):
        self._reset_idle()
        self.parent_handle = str(parent_handle or "")

        path = uri_to_path(uri)
        if path is None:
            # Remote or virtual location: there is no local file to read.
            return

        if close_if_already_shown and self.current_path == path and self.visible():
            self.close()
            return

        self.current_path = path
        if omarchy_shell(IPC_TARGET, "show", path) is None:
            # The overlay may not be mounted yet; summon() loads it first.
            omarchy_shell("shell", "summon", IPC_TARGET, json.dumps({"path": path}))

        # Report what actually happened, not what we asked for.
        self.set_visible(self.visible())

    def close(self):
        self._reset_idle()
        self.current_path = None
        omarchy_shell(IPC_TARGET, "dismiss")
        self.set_visible(False)


def make_handlers(previewer):
    def handle_call(_conn, _sender, _path, interface, method, params, invocation):
        if method == "ShowFile":
            if interface == "org.gnome.NautilusPreviewer2":
                uri, window_handle, close_if_shown, _token = params.unpack()
                previewer.show_file(uri, close_if_shown, window_handle)
            else:
                uri, _xid, close_if_shown = params.unpack()
                previewer.show_file(uri, close_if_shown)
            invocation.return_value(None)
        elif method == "Close":
            previewer.close()
            invocation.return_value(None)
        else:
            invocation.return_error_literal(
                Gio.dbus_error_quark(), Gio.DBusError.UNKNOWN_METHOD,
                "Unknown method %s" % method,
            )

    def handle_get(_conn, _sender, _path, _interface, prop):
        if prop == "Visible":
            return GLib.Variant("b", previewer.visible())
        if prop == "ParentHandle":
            return GLib.Variant("s", previewer.parent_handle)
        return None

    return handle_call, handle_get


def main():
    loop = GLib.MainLoop()
    previewer = Previewer(loop)
    handle_call, handle_get = make_handlers(previewer)

    node = Gio.DBusNodeInfo.new_for_xml(NODE_XML)
    registered = []

    def on_bus_acquired(connection, _name):
        previewer.connection = connection
        for interface in node.interfaces:
            registered.append(connection.register_object(
                OBJECT_PATH, interface, handle_call, handle_get, None,
            ))
        # Nautilus caches Visible for the life of its proxy: state it once now,
        # so a stale "true" left by a previous bridge cannot survive.
        previewer.set_visible(previewer.visible())

    def on_name_lost(_connection, _name):
        # Something else (most likely sushi) holds the name. Exiting keeps the
        # user's file manager working rather than fighting over the bus.
        sys.stderr.write(
            "quick-look-previewer: could not own %s; another previewer is running\n" % BUS_NAME
        )
        loop.quit()

    Gio.bus_own_name(
        Gio.BusType.SESSION, BUS_NAME,
        Gio.BusNameOwnerFlags.NONE,
        on_bus_acquired, None, on_name_lost,
    )

    try:
        loop.run()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
